# Copy to .env (or .env.dev / .env.test / .env.staging) and fill in.
# Precedence: real process env  >  .env.<TEST_ENV>  >  .env
#
# Only the authenticated checkout suite needs these. The guest, negative and
# accessibility suites run without any .env file at all.
#
# Register an account in seconds at https://www.demoblaze.com via "Sign up".
DEMOBLAZE_USER=
DEMOBLAZE_PASS=

# Parallel workers. A positive integer (4) or a percentage of cores ("50%").
# Each worker registers and signs in as its own DemoBlaze account, so raising
# this raises load on a shared public demo — 4 is about what it serves reliably.
# Unset falls back to 4 locally / 2 in CI.
PW_WORKERS=4

# Optional overrides.
# TEST_ENV=dev
# BASE_URL=https://www.demoblaze.com
# API_URL=https://api.demoblaze.com
